rules_version = '2';

// Default-deny for the Firebase Storage SDK path. As with Firestore:
//  - The bot uploads via firebase-admin, which bypasses these rules.
//  - The website never uses the client Storage SDK; downloads are streamed through
//    the BFF's /api/marketplace/download proxy (host/bucket/prefix/extension locked).
//
// NOTE: craft/blueprint/thumbnail objects are currently made world-readable with
// blob.make_public(), which grants a legacy *GCS object ACL*. That ACL is enforced
// by Cloud Storage independently of these Security Rules, so direct
// storage.googleapis.com URL downloads keep working regardless of this file — and
// this default-deny does not weaken or change that. These rules only govern the
// Firebase SDK access path, which nothing here uses. (Moving those objects off
// make_public() to signed URLs is tracked separately as the MEDIUM finding.)
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
