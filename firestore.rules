rules_version = '2';

// Default-deny. Nothing legitimate reaches Firestore through the client SDK:
//  - The Discord bot writes/reads via the firebase-admin SDK, which bypasses these
//    rules entirely, so denying here does NOT affect the bot.
//  - The website never touches Firestore directly; every read/write goes through the
//    same-origin BFF, which forwards to the bot.
//
// So any request these rules can see is by definition an unsanctioned direct client
// hit and must be refused. Keep this default-deny; grant narrowly and deliberately
// only if a genuine client-SDK path is ever added.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
